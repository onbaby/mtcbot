# Use a long, random value (for example: openssl rand -hex 32)
INSTALLATION_SECRET=replace-with-a-random-secret

# Client ID from a GroupMe application whose callback URL points to:
# https://YOUR_BACKEND/api/groupme/oauth
GROUPME_CLIENT_ID=replace-with-your-groupme-client-id

# Optional locally. Vercel derives this from the incoming request automatically.
PUBLIC_BASE_URL=http://localhost:3000
APP_URL=http://localhost:3000
